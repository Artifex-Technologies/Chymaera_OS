# Maintainer: Chymaera OS Contributors
#
# Local-dev/ISO-build package for Sarina. Builds directly from whatever
# commit the packages/sarina submodule is checked out to, so advancing it
# is just:
#   ./scripts/update-agent.sh
# followed by a rebuild — no tagged release or published tarball required.
#
# The AUR/release-oriented package (built from a tagged GitHub release
# tarball instead of a local checkout) is maintained upstream at
# packages/sarina/packaging/arch/PKGBUILD (pkgname=sarina there) and is the
# source of truth for the systemd unit, sysusers snippet, and env template
# installed below — this file only adapts *how the source is fetched*, not
# what gets installed.

_agent_src="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../sarina" && pwd)"

pkgname=sarina-git
pkgver=0.1.0.r0.g0000000
pkgrel=1
pkgdesc="Local-model security agent: Go core with an optional Python ML/voice helper (built from the local packages/sarina submodule checkout)"
arch=('x86_64' 'aarch64')
url="https://github.com/Artifex-Technologies/Sarina"
license=('MIT')
depends=('glibc')
optdepends=(
  'python: required for the optional ML/voice helper (sarina-helpers)'
  'python-onnxruntime: semantic search and desktop-audit classification (helper)'
  'claude-code: hand off tasks to the real Claude Code CLI when local resources are insufficient'
)
makedepends=('go' 'python-build' 'python-installer' 'python-wheel' 'python-setuptools' 'git')
provides=('sarina')
conflicts=('sarina')
source=("sarina::git+file://${_agent_src}")
sha256sums=('SKIP')

pkgver() {
  cd "$srcdir/sarina"
  printf "0.1.0.r%s.g%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
  cd "$srcdir/sarina/go"
  export CGO_ENABLED=0 GOFLAGS="-trimpath -mod=readonly -modcacherw"
  go build -ldflags "-s -w" -o sarina ./cmd/sarina

  cd ../python/sarina_helpers
  python -m build --wheel --no-isolation
}

package() {
  cd "$srcdir/sarina"

  install -Dm755 go/sarina "$pkgdir/usr/bin/sarina"
  ln -s sarina "$pkgdir/usr/bin/sarina-gui"
  ln -s sarina "$pkgdir/usr/bin/sarina-service"

  python -m installer --destdir="$pkgdir" python/sarina_helpers/dist/*.whl

  install -Dm644 packaging/arch/sarina-service.service \
    "$pkgdir/usr/lib/systemd/system/sarina-service.service"
  install -Dm644 packaging/arch/sarina.sysusers \
    "$pkgdir/usr/lib/sysusers.d/sarina.conf"
  install -Dm644 packaging/arch/service.env.example \
    "$pkgdir/etc/sarina/service.env.example"
  install -Dm644 README.md \
    "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 LICENSE \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 packaging/skills/ecosystem-troubleshoot/SKILL.md \
    "$pkgdir/usr/share/sarina/skills/ecosystem-troubleshoot/SKILL.md"

  # Omarchy's agents panel refreshes by running every omarchy-agent-usage-*
  # script in $OMARCHY_PATH/bin and writing each script's stdout to
  # ~/.local/state/omarchy/agents/usage/<agent>.json. This is Sarina's
  # collector. It is generated here, not taken from the Sarina repo, so it adds
  # no new path the packaging contract has to track. It depends on the
  # `fleet-usage` command, which exists only once the submodule pointer is at a
  # Sarina commit that has it; until then the panel logs a failed collector.
  install -Dm755 /dev/stdin "$pkgdir/usr/share/omarchy/bin/omarchy-agent-usage-sarina" <<'EOF'
#!/bin/bash

# omarchy:summary=Print the Sarina usage record as JSON
# omarchy:args=[--force] [--limits-only]
# omarchy:hidden=true

exec sarina fleet-usage "$@"
EOF
}
